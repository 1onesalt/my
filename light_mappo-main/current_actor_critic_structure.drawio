<mxfile host="app.diagrams.net" modified="2026-03-16T00:00:00.000Z" agent="Cursor" version="26.0.11">
  <diagram id="current-actor-critic" name="Current Actor Critic Structure">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="light_mappo-main 当前 Actor / Critic 数据流" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="默认代码路径：use_fusion_network=True，use_centralized_V=True，hidden_size=64。&#xa;只有启用循环策略时，GRU 分支才会生效。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="620" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="env" value="TargetSearchEnv&#xa;每个智能体的原始局部观测&#xa;{polar_grid (16x16x4), self_state (3)}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="wrapper" value="FlattenObservation&#xa;将局部观测压平&#xa;[grid_flat(1024) | self_state(3)] = 1027" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="actorInput" value="Actor 输入&#xa;每个智能体的局部扁平观测&#xa;shape = 1027" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="shareBuild" value="runner/shared/env_runner.py&#xa;build_share_obs()&#xa;拼接每个智能体的 [local_obs, active_mask]&#xa;再 reshape 并复制给所有智能体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="criticInput" value="Critic 输入&#xa;集中式 share_obs&#xa;2 个智能体时：(1027 + 1) x 2 = 2056" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="335" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="actorFusion" value="R_Actor 主干 = FusionCNN（single mode）&#xa;将局部观测拆分为：&#xa;grid 1024 -&gt; reshape 为 4x16x16&#xa;vector 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="criticFusion" value="R_Critic 主干 = FusionCNN（dual mode）&#xa;将 2056 拆分为：&#xa;agent1 obs 1027 | agent2 obs 1027 | 尾部 2 个 mask&#xa;每个 agent obs = grid 1024 + state 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1220" y="325" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cnnActor" value="FusionCNN 中共享的 CNN&#xa;Conv 4-&gt;16, k3 s1 p1&#xa;Conv 16-&gt;32, k3 s2 p1&#xa;Conv 32-&gt;32, k3 s2 p1&#xa;Flatten 后得到 512 维" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="105" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cnnCritic" value="同一个共享 CNN 分别作用于每个智能体的 grid&#xa;CNN(grid1) = 512&#xa;CNN(grid2) = 512&#xa;拼接全部 CNN 输出 = 1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1570" y="315" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="actorFuseMlp" value="Actor 融合 MLP&#xa;concat [cnn_feat 512, self_state 3] = 515&#xa;Linear 515-&gt;64 + ReLU + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1490" y="115" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="criticFuseMlp" value="Critic 融合 MLP&#xa;concat [cnn1 512, cnn2 512, state1 3, state2 3, masks 2] = 1032&#xa;Linear 1032-&gt;64 + ReLU + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1870" y="315" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="actorGru" value="可选 GRU&#xa;RNNLayer(64 -&gt; 64), recurrent_N=1&#xa;仅在启用循环策略时使用" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1810" y="115" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="criticGru" value="可选 GRU&#xa;RNNLayer(64 -&gt; 64), recurrent_N=1&#xa;仅在启用循环策略时使用" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2230" y="315" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="actHead" value="ACTLayer&#xa;离散动作头&#xa;Linear 64-&gt;7 logits&#xa;Categorical 采样 / 取最大概率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2090" y="115" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="valueHead" value="价值头&#xa;v_out: Linear 64-&gt;1&#xa;（若启用则改为 PopArt 64-&gt;1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2510" y="315" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="actionOut" value="Actor 输出&#xa;action + log_prob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2380" y="125" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="valueOut" value="Critic 输出&#xa;状态价值 V(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2790" y="325" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="warning" value="重要：训练时，环境内部的 share_obs_n / global_grid 目前并没有直接送入 Critic。&#xa;Critic 实际接收的是 runner 中重新构造的“局部扁平观测拼接 active_mask”向量。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
